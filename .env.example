# The public origin this instance is reachable at. Used to build the absolute
# feed URLs, the <img> URLs inside feed items, and the channel <link>. Behind a
# reverse proxy (Docker/Coolify) the request's own host is the internal container
# address, so this has to be configured explicitly.
#
# Changing it is safe: on the next boot the stored absolute asset URLs are
# rewritten to the new origin.
PUBLIC_BASE_URL=http://localhost:3000

# Port the Express server listens on.
PORT=3000

# Optional: route Instagram traffic (profile fetches *and* image downloads)
# through an HTTP proxy so Instagram doesn't see a datacenter IP. Format:
# http://user:password@host:port, with country/session targeting in the creds.
#
# Sticky sessions: include the literal token {session} anywhere in the URL and it
# is substituted per request. The adapter primes a logged-out guest session and
# then makes the profile request, and the two must leave from the same exit IP —
# that's what the placeholder is for. A retry after an IP-level block rotates to
# a fresh session id, and thus a fresh IP. With no {session} token the proxy just
# rotates per request. Works with any session-capable HTTP proxy.
#
# Decodo residential (https://decodo.com) — targeting/session go in the username:
# OUTBOUND_PROXY_URL=http://user-<DECODO_USERNAME>-country-us-session-{session}:<DECODO_PASSWORD>@gate.decodo.com:7000
OUTBOUND_PROXY_URL=

# Optional: a Decodo dashboard API key, used only to show how much residential
# proxy traffic is still available in the status footer. This is separate from
# the proxy credentials in OUTBOUND_PROXY_URL above — it authenticates the
# provider's billing API (GET https://api.decodo.com/v2/subscriptions), polled
# once an hour. Set it to the value Decodo lists for the Authorization header
# (e.g. "Basic <base64>"). Leave unset to hide the footer line.
DECODO_API_TOKEN=

# Optional: debug | info | warn | error. Defaults to info.
LOG_LEVEL=info
